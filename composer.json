{
    "name": "d3creative/statamic-canary",
    "description": "Canary by D3 Creative - checks a Statamic site's form emails and integrations still work, without saving a submission or emailing the client.",
    "type": "statamic-addon",
    "license": "MIT",
    "authors": [
        {
            "name": "D3 Creative",
            "homepage": "https://d3creative.uk"
        }
    ],
    "require": {
        "php": "^8.3",
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.8 || ^11.0",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "D3Creative\\Canary\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "D3Creative\\Canary\\Tests\\": "tests/"
        }
    },
    "extra": {
        "statamic": {
            "name": "Canary",
            "description": "Send a form's real emails to yourself through the queue and check its integrations, without saving a submission.",
            "developer": "D3 Creative",
            "developer_url": "https://d3creative.uk",
            "tags": [
                "forms",
                "email",
                "maintenance"
            ]
        },
        "laravel": {
            "providers": [
                "D3Creative\\Canary\\ServiceProvider"
            ]
        }
    },
    "prefer-stable": true
}
